{
  "openapi": "3.1.0",
  "info": {
    "title": "TARZAN Workflow Reliability Machine Commerce Sandbox",
    "version": "0.2",
    "description": "Discover, price, authorize, sandbox-pay, execute and reconcile the AgentProof-verified WORKFLOW_RELIABILITY Economic Artifact. Live payment is disabled."
  },
  "servers": [
    {
      "url": "https://communications-outstanding-digest-before.trycloudflare.com"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Phase-6 sandbox health"
          }
        }
      }
    },
    "/capabilities": {
      "get": {
        "operationId": "listCapabilities",
        "responses": {
          "200": {
            "description": "Capability, pricing and AgentProof metadata"
          }
        }
      }
    },
    "/commerce/payment-methods": {
      "get": {
        "operationId": "listPaymentMethods",
        "responses": {
          "200": {
            "description": "Available sandbox methods"
          }
        }
      }
    },
    "/commerce/offer": {
      "post": {
        "operationId": "createCommerceOffer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Machine-readable CHF offer"
          }
        }
      }
    },
    "/commerce/challenge": {
      "post": {
        "operationId": "authorizeAndChallenge",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChallengeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized MPP/x402 sandbox challenge"
          }
        }
      }
    },
    "/commerce/complete": {
      "post": {
        "operationId": "completeMachineCommerce",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Settlement, verified result and reconciliation"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OfferRequest": {
        "type": "object",
        "required": [
          "buyer_id",
          "capability_id"
        ],
        "properties": {
          "buyer_id": {
            "type": "string"
          },
          "capability_id": {
            "type": "string",
            "const": "WORKFLOW_RELIABILITY"
          }
        }
      },
      "BuyerMandate": {
        "type": "object",
        "required": [
          "mandate_id",
          "buyer_id",
          "seller_id",
          "capability_id",
          "currency",
          "max_amount_chf",
          "expires_at",
          "allowed_rails"
        ],
        "properties": {
          "mandate_id": {
            "type": "string"
          },
          "buyer_id": {
            "type": "string"
          },
          "seller_id": {
            "type": "string",
            "const": "TARZAN_FORGE"
          },
          "capability_id": {
            "type": "string",
            "const": "WORKFLOW_RELIABILITY"
          },
          "currency": {
            "type": "string",
            "const": "CHF"
          },
          "max_amount_chf": {
            "type": "number",
            "minimum": 299.0
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "allowed_rails": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "MPP_SEMANTIC_SANDBOX",
                "X402_V2_SEMANTIC_SANDBOX"
              ]
            }
          }
        }
      },
      "ChallengeRequest": {
        "type": "object",
        "required": [
          "offer_id",
          "mandate",
          "rail_id"
        ],
        "properties": {
          "offer_id": {
            "type": "string"
          },
          "mandate": {
            "$ref": "#/components/schemas/BuyerMandate"
          },
          "rail_id": {
            "type": "string",
            "enum": [
              "MPP_SEMANTIC_SANDBOX",
              "X402_V2_SEMANTIC_SANDBOX"
            ]
          }
        }
      },
      "SandboxCredential": {
        "type": "object",
        "required": [
          "challenge_id",
          "mandate_id",
          "buyer_id",
          "nonce",
          "amount_chf",
          "currency",
          "proof"
        ],
        "properties": {
          "challenge_id": {
            "type": "string"
          },
          "mandate_id": {
            "type": "string"
          },
          "buyer_id": {
            "type": "string"
          },
          "nonce": {
            "type": "string"
          },
          "amount_chf": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "const": "CHF"
          },
          "proof": {
            "type": "string",
            "description": "Lowercase SHA-256 hex of the canonical proof material."
          },
          "simulate_failure": {
            "type": "boolean",
            "default": false,
            "description": "Sandbox test control only."
          },
          "sandbox_only": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "CompleteRequest": {
        "type": "object",
        "required": [
          "challenge_id",
          "credential",
          "idempotency_key",
          "input"
        ],
        "properties": {
          "challenge_id": {
            "type": "string"
          },
          "credential": {
            "$ref": "#/components/schemas/SandboxCredential"
          },
          "idempotency_key": {
            "type": "string"
          },
          "input": {
            "type": "object",
            "required": [
              "workflow"
            ],
            "properties": {
              "workflow": {
                "type": "object",
                "required": [
                  "nodes",
                  "connections"
                ],
                "properties": {
                  "nodes": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "connections": {
                    "type": "object"
                  },
                  "settings": {
                    "type": "object"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        }
      }
    }
  },
  "x-tarzan-identity": "urn:air:constantiniulian664-ui.github.io:api:workflow-reliability",
  "x-tarzan-phase": 6,
  "x-tarzan-public-sandbox": true,
  "x-tarzan-live-payment": false,
  "x-tarzan-reference-price": {
    "amount": 299.0,
    "currency": "CHF",
    "state": "HYPOTHESIS",
    "chargedLive": false
  },
  "x-tarzan-payment-router": {
    "mode": "SANDBOX_ONLY",
    "seller_id": "TARZAN_FORGE",
    "rails": [
      {
        "id": "MPP_SEMANTIC_SANDBOX",
        "protocol": "MPP",
        "intent": "charge",
        "fullProtocolComplianceClaimed": false
      },
      {
        "id": "X402_V2_SEMANTIC_SANDBOX",
        "protocol": "X402",
        "version": 2,
        "scheme": "exact",
        "fullProtocolComplianceClaimed": false
      }
    ]
  },
  "x-tarzan-sandbox-credential-proof": {
    "algorithm": "SHA-256",
    "encoding": "lowercase hexadecimal",
    "canonicalization": "UTF-8 JSON; sort keys; separators comma and colon; no extra whitespace",
    "material_fields": [
      "challenge_id",
      "mandate_id",
      "buyer_id",
      "nonce",
      "amount_chf",
      "currency"
    ],
    "warning": "This proof is a sandbox integrity token, not cryptographic buyer authentication."
  },
  "x-tarzan-authority": {
    "system": "AURA",
    "automatic_external_spend_chf": 0.0,
    "owner_risk_cap_chf": 50.0
  },
  "x-tarzan-verification": {
    "system": "AgentProof",
    "artifact": "WORKFLOW_RELIABILITY",
    "phase3_verified": true
  },
  "x-tarzan-truth": {
    "real_funds_moved": false,
    "real_settlement": false,
    "real_revenue": false,
    "sandbox_revenue_excluded_from_profit": true
  },
  "x-tarzan-commerce-recipe": {
    "version": "0.1",
    "payment_methods_path": "/commerce/payment-methods",
    "steps": [
      {
        "id": "offer",
        "method": "POST",
        "path": "/commerce/offer",
        "body": {
          "buyer_id": "$buyer_id",
          "capability_id": "WORKFLOW_RELIABILITY"
        }
      },
      {
        "id": "mandate",
        "local_transform": {
          "mandate_id": "MANDATE-$offer.offer_id-$buyer_id",
          "buyer_id": "$buyer_id",
          "seller_id": "$offer.seller_id",
          "capability_id": "$offer.capability_id",
          "currency": "$offer.currency",
          "max_amount_chf": "$offer.amount_chf",
          "expires_at": "$now_plus_10_minutes",
          "allowed_rails": [
            "$rail_id"
          ],
          "sandbox_only": true
        }
      },
      {
        "id": "challenge",
        "method": "POST",
        "path": "/commerce/challenge",
        "body": {
          "offer_id": "$offer.offer_id",
          "mandate": "$mandate",
          "rail_id": "$rail_id"
        }
      },
      {
        "id": "credential",
        "local_transform": {
          "challenge_id": "$challenge.challenge.challenge_id",
          "mandate_id": "$mandate.mandate_id",
          "buyer_id": "$buyer_id",
          "nonce": "$challenge.challenge.nonce",
          "amount_chf": "$challenge.challenge.amount_chf",
          "currency": "$challenge.challenge.currency",
          "proof": "$sha256_canonical_proof_material",
          "simulate_failure": false,
          "sandbox_only": true
        }
      },
      {
        "id": "complete",
        "method": "POST",
        "path": "/commerce/complete",
        "body": {
          "challenge_id": "$challenge.challenge.challenge_id",
          "credential": "$credential",
          "idempotency_key": "$buyer_generated_unique_key",
          "input": "$capability_input"
        }
      }
    ],
    "truth": {
      "seller_builds_buyer_credential": false,
      "live_payment": false,
      "real_funds_moved": false
    }
  }
}
